---
interface Props { showDisclaimer?: boolean }

const { showDisclaimer = true } = Astro.props;
---
<footer class="border-rule border-t">
  <div class="max-w-page text-ink-soft mx-auto px-5 py-8 text-sm md:px-8 lg:px-10">
    <p class="mb-2">Taxfold is a receipt and expense log for iPhone. It sends us none of your data.</p>
    {showDisclaimer && <p class="mb-2">Guides on this site are general information, not tax, legal or accounting advice.</p>}
    <p>© Opal Harmony P.C.</p>
    <ul class="footer-links">
      <li><a class="footer-link" href="/how-we-write/">How we write</a></li>
      <li><a class="footer-link" href="/privacy/">Privacy</a></li>
      <li><a class="footer-link" href="mailto:hello@taxfold.app">hello@taxfold.app</a></li>
      <li><a class="footer-link" href="https://opalharmony.gr/">Company details</a></li>
    </ul>
  </div>
</footer>
