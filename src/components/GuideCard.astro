---
import { curlyApostrophes } from '../lib/typography.mjs';

interface Props {
  title: string;
  description: string;
  href: string;
  variant?: 'full' | 'compact';
}

const { title, description, href, variant = 'full' } = Astro.props;
---
<li>
  <article class:list={['card', variant === 'compact' && 'card-compact']}>
    <h3 class="card-title"><a href={href}>{curlyApostrophes(title)}</a></h3>
    {variant === 'full' && <p class="text-ink-soft mt-1">{curlyApostrophes(description)}</p>}
  </article>
</li>
