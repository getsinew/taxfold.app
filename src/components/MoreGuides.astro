---
import { getCollection } from 'astro:content';
import GuideCard from './GuideCard.astro';

interface Props { currentId?: string }

const MAX_MORE_GUIDES = 4;
const { currentId } = Astro.props;
const others = (await getCollection('guides'))
  .filter((guide) => guide.id !== currentId)
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, MAX_MORE_GUIDES);
---
{others.length > 0 && (
  <section aria-labelledby="more-guides" class="mt-10">
    <h2 id="more-guides" class="mb-3">More guides</h2>
    <ul class="flex flex-col gap-4">
      {others.map((guide) => (
        <GuideCard variant="compact" title={guide.data.title} description={guide.data.description} href={`/guides/${guide.id}/`} />
      ))}
    </ul>
  </section>
)}
