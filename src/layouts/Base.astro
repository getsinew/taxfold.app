---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { launchView } from '../lib/launch-state.mjs';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, noindex = false, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const appBanner = launchView().itunesMeta?.(canonical);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#f6f4ee" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#131614" media="(prefers-color-scheme: dark)" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Taxfold" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {appBanner && <meta name="apple-itunes-app" content={appBanner} />}
  <slot name="head" />
</head>
<body class="flex min-h-screen flex-col">
  <a href="#main" class="skip-link">Skip to content</a>
  <Header />
  <main id="main" tabindex="-1" class="max-w-page mx-auto w-full flex-1 px-5 py-10 md:px-8 md:py-12 lg:px-10">
    <slot />
  </main>
  <Footer />
</body>
</html>
