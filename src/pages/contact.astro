---
import Base from '../layouts/Base.astro';
import { launchView } from '../lib/launch-state.mjs';

const { makerStatus } = launchView();
---
<Base
  title="Contact Taxfold"
  description="Email the Taxfold team at hello@taxfold.app with questions about the app, corrections to a guide, or press enquiries."
>
  <article class="prose">
    <h1>Contact</h1>
    <p class="text-lg">Email <a href="mailto:hello@taxfold.app">hello@taxfold.app</a>.</p>
    <p>A person on the Taxfold team reads every message.</p>
    <ul>
      <li><strong>Corrections:</strong> name the guide and what is wrong; we fix errors and update the page’s date.</li>
      <li><strong>Privacy questions:</strong> <a href="mailto:privacy@taxfold.app">privacy@taxfold.app</a>.</li>
      <li><strong>The app:</strong> {makerStatus}</li>
    </ul>
    <p>
      We cannot give tax, legal or accounting advice about your own situation.
    </p>
  </article>
</Base>
